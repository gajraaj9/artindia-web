+.pg-day:has(.pg-day-img){min-height:clamp(200px,27vw,330px)}
+.pg-day-img{position:absolute;inset:0;z-index:-2;transition:filter .18s ease}
+.pg-day-img img{width:100%;height:100%;object-fit:cover}
+.pg-day:has(.pg-day-img)::after{content:"";position:absolute;inset:0;z-index:-1;
